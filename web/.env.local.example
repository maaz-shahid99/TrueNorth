# Engine base URL (FastAPI). Local dev default:
ENGINE_URL=http://127.0.0.1:8000

# Dev API key used by the BFF to call the engine. Mint one with:
#   conda run -n truenorth truenorth-admin mint --subject dev --role admin
ENGINE_API_KEY=

# --- Google SSO (UI-6) ---
# Set both to enable the "Continue with Google" button. The OAuth redirect URI to register
# in Google Cloud is: http://localhost:3000/api/auth/google/callback
# The engine must also have GOOGLE_CLIENT_ID + TRUENORTH_JWT_SECRET set (and optionally
# SSO_ADMIN_EMAILS) so it can verify the Google token and mint a session JWT.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
